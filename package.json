{
  "name": "meta-theory-experiments",
  "version": "1.1.0",
  "type": "module",
  "description": "Experiments and scripts for meta-theory repository",
  "scripts": {
    "test": "node scripts/verify.mjs --all",
    "verify": "node scripts/verify.mjs --all",
    "verify:0.0.0": "node scripts/verify.mjs 0.0.0",
    "verify:0.0.1": "node scripts/verify.mjs 0.0.1",
    "verify:0.0.2": "node scripts/verify.mjs 0.0.2",
    "download:articles": "node scripts/download-article.mjs --all",
    "download:article:0.0.0": "node scripts/download-article.mjs 0.0.0",
    "download:article:0.0.1": "node scripts/download-article.mjs 0.0.1",
    "download:article:0.0.2": "node scripts/download-article.mjs 0.0.2",
    "download:images": "node scripts/download.mjs --all --images",
    "download:screenshots": "node scripts/download.mjs --all --screenshot",
    "download:markdown-images": "node scripts/download-markdown-images.mjs --all",
    "download:all": "npm run download:articles && npm run download:markdown-images && npm run download:screenshots && npm run verify",
    "capture:animation": "node scripts/capture-animation.mjs",
    "capture:itself": "node scripts/capture-animation.mjs https://linksplatform.github.io/itself.html --output docs/animations/closed-link.gif --extract-keyframes",
    "capture:itself:slow": "node scripts/capture-animation.mjs https://linksplatform.github.io/itself.html --output docs/animations/closed-link.gif --speed 0.5 --extract-keyframes",
    "capture:itself:mp4": "node scripts/capture-animation.mjs https://linksplatform.github.io/itself.html --output docs/animations/closed-link.mp4 --format mp4",
    "capture:itself:webm": "node scripts/capture-animation.mjs https://linksplatform.github.io/itself.html --output docs/animations/closed-link.webm --format webm",
    "test:capture": "node scripts/test-capture-quality.mjs",
    "test:web-capture": "node scripts/test-web-capture-integration.mjs",
    "test:habr-sync": "node --test tests/habr*.test.mjs",
    "habr:sync": "node scripts/habr-article-sync.mjs",
    "build:pdf": "node scripts/build-pdf.mjs --all",
    "test:pdf": "node --test scripts/test-pdf.mjs",
    "verify:pdf": "node scripts/validate-pdfs.mjs",
    "release:pdf": "node scripts/release-pdfs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/meta-theory.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/link-foundation/meta-theory/issues"
  },
  "homepage": "https://github.com/link-foundation/meta-theory#readme",
  "dependencies": {
    "@fontsource/noto-sans-mono": "5.2.9",
    "@fontsource/noto-serif": "5.2.9",
    "@link-assistant/web-capture": "1.7.6",
    "browser-commander": "0.25.0",
    "diff": "8.0.2",
    "fflate": "0.8.3",
    "gif-encoder-2": "^1.0.5",
    "jpeg-js": "^0.4.4",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-texmath": "1.0.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "puppeteer": "25.12.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.40.0",
    "esbuild": "0.25.12",
    "pdfjs-dist": "6.4.299"
  }
}
